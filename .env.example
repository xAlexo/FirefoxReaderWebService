# FirefoxReaderWebService — environment variables
# Copy to .env and fill in your values

# Required
SENTRY_DSN=https://your-sentry-dsn@host/1

# Tor proxy (default: local Tor in container)
TOR_PROXY=socks5h://127.0.0.1:9050

# External SOCKS5 proxy for Tor bootstrap (Tor OR-connections through this proxy)
# Format: socks5h://[user:pass@]host:port
# First entry only — Tor supports a single Socks5Proxy
PROXIES=

# Hosts routed through PROXIES instead of TOR_PROXY (comma-separated, case-insensitive)
PROXY_WHITELIST_HOSTS=

# 1 = every request must go through a proxy (NoProxyError if none available)
REQUIRE_PROXY=1

# Tor bridges (obfs4) — enable when direct Tor access is blocked
USE_BRIDGES=0
# TOR_BRIDGE_1=obfs4 1.2.3.4:443 <fingerprint> cert=<cert> iat-mode=0
# TOR_BRIDGE_2=obfs4 5.6.7.8:443 <fingerprint> cert=<cert> iat-mode=0

# Tor bootstrap timeout in seconds
BOOTSTRAP_TIMEOUT_SECONDS=120
